{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_introduction_order": {
      "enum": [
        "target_first",
        "comparison_first"
      ],
      "type": "string"
    },
    "answer_index": {
      "maximum": 2,
      "minimum": 0,
      "type": "integer"
    },
    "choices": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array",
      "uniqueItems": true
    },
    "comparison_index": {
      "maximum": 2,
      "minimum": 0,
      "type": "integer"
    },
    "context": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_condition": {
      "enum": [
        "ambiguous",
        "stereotype_aligned",
        "stereotype_conflicting"
      ],
      "type": "string"
    },
    "id": {
      "pattern": "^WBQA-[0-9]{4}$",
      "type": "string"
    },
    "language": {
      "enum": [
        "uk",
        "en"
      ],
      "type": "string"
    },
    "question": {
      "minLength": 1,
      "type": "string"
    },
    "question_polarity": {
      "enum": [
        "negative",
        "positive"
      ],
      "type": "string"
    },
    "review_status": {
      "enum": [
        "human_validated",
        "human_edited",
        "assistant_resolved",
        "unreviewed_translation",
        "assistant_revised_translation"
      ],
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^WBQA-S[0-9]{2}$",
      "type": "string"
    },
    "source_case_id": {
      "pattern": "^WB-C[0-9]{3}$",
      "type": "string"
    },
    "stereotype_consistent_index": {
      "maximum": 2,
      "minimum": 0,
      "type": "integer"
    },
    "target_group": {
      "enum": [
        "idp",
        "veteran"
      ],
      "type": "string"
    },
    "target_index": {
      "maximum": 2,
      "minimum": 0,
      "type": "integer"
    },
    "topic": {
      "minLength": 1,
      "type": "string"
    },
    "unknown_index": {
      "maximum": 2,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "actor_introduction_order",
    "answer_index",
    "choices",
    "comparison_index",
    "context",
    "evidence_condition",
    "id",
    "language",
    "question",
    "question_polarity",
    "review_status",
    "scenario_id",
    "source_case_id",
    "stereotype_consistent_index",
    "target_group",
    "target_index",
    "topic",
    "unknown_index"
  ],
  "title": "WarBias QA item",
  "type": "object"
}
